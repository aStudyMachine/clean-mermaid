{
  "name": "clean-mermaid",
  "version": "0.1.10",
  "description": "Render Mermaid diagrams as clean cards for Obsidian with Pele, ELK and Dagre layouts, auto-fit, zoom/pan, image preview, PNG/SVG export and custom themes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/build.mjs && node tests/browser/serve.mjs",
    "shots": "node tests/browser/build.mjs capture && node tests/browser/capture-server.mjs",
    "extract-mermaid": "node scripts/extract-obsidian-mermaid.mjs",
    "verify:takeover": "node scripts/verify-takeover.mjs",
    "deploy": "node scripts/deploy.mjs",
    "extract-pele": "node scripts/extract-obsidian-pele.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mermaid",
    "diagram",
    "flowchart",
    "pele"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/view": "6.38.6",
    "@dagrejs/dagre": "1.1.5",
    "elkjs": "0.9.3",
    "json5": "2.2.3",
    "mathjax-full": "3.2.2",
    "mermaid": "12.1.0",
    "pele": "1.13.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "^0.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
